# DeepSeek API key. Pi reads this automatically (provider "deepseek") for model
# access. Copy this file to .env and fill it in; do not commit .env.
DEEPSEEK_API_KEY=sk-...

# Optional: host folder to mount READ-ONLY inside the container (the agent can
# read the data but cannot modify it). Only used when you start with the
# read-only override, e.g.:
#   DATASETS_DIR=/media/dan/data/dev/datasets/test \
#   docker compose -f compose.yaml -f compose.ro.yaml up -d
# DATASETS_DIR=/media/dan/data/dev/datasets/test
