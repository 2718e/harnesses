#!/bin/bash
# Refresh guest configuration; skill installation happens at VM creation.
set -euo pipefail
config_root=$(cd -- "$(dirname -- "$0")/.." && pwd)
mkdir -p "$HOME/.codex"
install -m 0644 "$config_root/codex/config.toml" "$HOME/.codex/config.toml"
ln -sfnT "$config_root/AGENTS.md" "$HOME/.codex/AGENTS.md"
