# Host-side helpers for the Lima agent harness VM.
set shell := ["bash", "-uc"]

default:
    @just --list

# Create the persistent disk once. Never run this to replace an existing disk.
create-persistent-disk size="20GiB":
    limactl disk create agvm-p --size {{size}}

# Create or start the VM, initializing the persistent shared database.
setup:
    uv run --locked --directory scripts python -m vm_tools.start_vm setup ../mountavm.yaml

# Backwards-compatible name for the complete setup.
create: setup

start:
    uv run --locked --directory scripts python -m vm_tools.start_vm check-disk
    limactl start --timeout=30m agentvm

stop:
    limactl stop agentvm

restart:
    uv run --locked --directory scripts python -m vm_tools.start_vm check-disk
    -limactl stop agentvm
    limactl start --timeout=30m agentvm

# Delete and recreate the VM. Guest state and auth are lost; the separately
# created agvm-p disk is retained. Ensure it exists before deleting the VM.
recreate:
    uv run --locked --directory scripts python -m vm_tools.start_vm recreate ../mountavm.yaml

delete:
    limactl delete --force agentvm

# Permanently delete databases, credentials and Tailscale identity. Stop the VM first.
delete-persistent-disk:
    limactl disk delete agvm-p

# Permanently delete the VM and its persistent disk.
[confirm("Permanently delete agentvm AND agvm-p, including databases, credentials and Tailscale identity?")]
nuke:
    @just delete
    @just delete-persistent-disk

shell:
    limactl shell agentvm

status:
    limactl list agentvm

# Sync mountavm.yaml into the stopped instance. Fails if the VM is running.
update-mounts:
    uv run --locked --directory scripts python -m vm_tools.update_mounts agentvm ../mountavm.yaml
    @echo "Mounts updated. Run 'just start'."

# Refresh harness configuration in the guest.
sync-config:
    limactl shell agentvm bash /opt/agent-config/bin/sync-agent-config

# Show the installed tools and the most recent cloud-init status.
doctor:
    limactl shell agentvm bash -lc 'id; for tool in skills just t3 codex ast-grep tree-sitter node pnpm uv docker tmux tailscale; do printf "%s: " "$tool"; command -v "$tool" || true; done; printf "passwordless sudo: "; if sudo -n true; then echo available; else echo unavailable; fi; docker compose version; findmnt /mnt/lima-agvm-p; cloud-init status --long || true'

snapshot:
    limactl snapshot create agentvm --tag baseline

# Run host-side Python tests.
test:
    uv run --locked --directory scripts python -m unittest discover -s tests
