# Host-side helpers for the Lima agent harness VM.
set shell := ["bash", "-uc"]

default:
    @just --list

# Create the persistent disk once. Never run this to replace an existing disk.
create-db-disk size="20GiB":
    limactl disk create pgdata --size {{size}}

# Create and start the VM from the host-specific mount definition.
create:
    uv run --locked --directory scripts python -m vm_tools.start_vm create ../mountavm.yaml

start:
    limactl start agentvm

stop:
    limactl stop agentvm

restart:
    -limactl stop agentvm
    limactl start agentvm

# Delete and recreate the VM. Guest state and auth are lost; the separately
# created pgdata disk is retained. Ensure it exists before deleting the VM.
recreate:
    limactl disk list --json | uv run --locked --directory scripts python -m vm_tools.check_db_disk
    uv run --locked --directory scripts python -m vm_tools.start_vm recreate ../mountavm.yaml

delete:
    limactl delete --force agentvm

shell:
    limactl shell agentvm

status:
    limactl list agentvm

# Sync mountavm.yaml into the stopped instance. Fails if the VM is running.
update-mounts:
    uv run --locked --directory scripts python -m vm_tools.update_mounts agentvm ../mountavm.yaml
    @echo "Mounts updated. Run 'just start'."

# Copy tracked config into the guest.
sync-config:
    limactl shell agentvm bash -lc 'mkdir -p "$HOME/.codex" "$HOME/.dsh" && install -m 0644 /opt/agent-config/codex/config.toml "$HOME/.codex/config.toml" && ln -sfn /opt/agent-config/AGENTS.md "$HOME/.codex/AGENTS.md" && ln -sfn /opt/agent-config/AGENTS.md "$HOME/.dsh/AGENTS.md"'

# Show the installed tools and the most recent cloud-init status.
doctor:
    limactl shell agentvm bash -lc 'id; for tool in dsh codex ast-grep tree-sitter node pnpm uv docker; do printf "%s: " "$tool"; command -v "$tool" || true; done; docker compose version; findmnt /mnt/lima-pgdata; cloud-init status --long || true'

snapshot:
    limactl snapshot create agentvm --tag baseline

# Run host-side Python tests.
test:
    uv run --locked --directory scripts python -m unittest discover -s tests
